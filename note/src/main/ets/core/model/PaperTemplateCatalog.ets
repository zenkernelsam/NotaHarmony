// pgc.a: filter by size+orientation, then min squared-RGB distance to the
// requested hex (wp byte-17), tie-break by colorHex string (lec byte-1).
export function resolveBundledPaperVariant(template: BundledPaperTemplate,
  size: PaperSize, orientation: PageOrientation,
  colorHex: string | null): BundledPaperVariant | null {
  const target: number | null = parseTemplateHex6(colorHex);
  if (target === null) {
    return null;
  }
  let best: BundledPaperVariant | null = null;
  let bestDistance: number = 0x7fffffff;
  for (const variant of template.variants) {
    if (variant.size !== size || variant.orientation !== orientation) {
      continue;
    }
    const value: number | null = parseTemplateHex6(variant.colorHex);
    if (value === null) {
      continue;
    }
    const dr: number = ((value >> 16) & 0xff) - ((target >> 16) & 0xff);
    const dg: number = ((value >> 8) & 0xff) - ((target >> 8) & 0xff);
    const db: number = (value & 0xff) - (target & 0xff);
    const distance: number = dr * dr + dg * dg + db * db;
    if (best === null || distance < bestDistance ||
      (distance === bestDistance && variant.colorHex < best.colorHex)) {
      best = variant;
      bestDistance = distance;
    }
  }
  return best;
}

// Phase 1402 s7n.d/mapI0：recents/favorites 存的是 pdfAssetPath（chc.e），
// 反查时按 exact path 找到存入的 exact variant（不再按当前页上下文重解析）。
export interface BundledPaperVariantMatch {
  template: BundledPaperTemplate;
  variant: BundledPaperVariant;
}

export function findBundledPaperVariantByPath(
  rawfilePath: string): BundledPaperVariantMatch | null {
  for (const template of BUNDLED_PAPER_TEMPLATES) {
    for (const variant of template.variants) {
      if (variant.rawfilePath === rawfilePath) {
        return { template: template, variant: variant };
      }
    }
  }
  return null;
}

export function parseTemplateHex6(hex: string | null): number | null {
  if (hex === null || hex.length !== 6) {
    return null;
  }
  const value: number = parseInt(hex, 16);
  if (!Number.isSafeInteger(value) || value < 0 || value > 0xffffff ||
    !/^[0-9a-fA-F]{6}$/.test(hex)) {
    return null;
  }
  return value;
}
