// Phase 1401 bundled paper-template catalog — generated from original
// decompiled_1.4.2/resources/assets/papertemplates/*/metadata.json + pack file
// lists (Phase 761 registered the schema). Variant table replicates zgc.b:
// "<P>_<Size>_<hex6>[_portrait|landscape].pdf" and the thumb-gate visibility
// rule; Harmony rasterizes PDF previews, so needsLightThumbInk is metadata only.
// Ordering replicates rgc: category.ordinal -> displayIndex(absent=MAX) -> name.

import { PageOrientation, PaperSize } from './NoteTypes';

export enum BundledPaperCategory {
  NOTEPADS = 0,
  ACADEMIC = 1,
  CREATIVE = 2,
  PLANNING = 3,
  SELF_CARE = 4,
}

export interface BundledPaperVariant {
  size: PaperSize;
  colorHex: string;
  orientation: PageOrientation;
  needsLightThumbInk: boolean;
  rawfilePath: string;
}

export interface BundledPaperTemplate {
  dir: string;
  uuid: string;
  name: string;
  category: BundledPaperCategory;
  displayIndex: number;
  paperSizes: PaperSize[];
  defaultSize: PaperSize;
  colors: string[];
  variants: BundledPaperVariant[];
}

