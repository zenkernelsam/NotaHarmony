{
  "module": {
    "name": "note",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "NoteAbility",
    "deviceTypes": [
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:microphone_permission_reason",
        "usedScene": {
          "abilities": ["NoteAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:read_pasteboard_permission_reason",
        "usedScene": {
          "abilities": ["NoteAbility"],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "NoteAbility",
        "srcEntry": "./ets/noteability/NoteAbility.ets",
        "description": "$string:NoteAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:NoteAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "metadata": [
          {
            "name": "ohos.ability.shortcuts",
            "resource": "$profile:shortcuts_config"
          }
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            "entities": [
              "entity.system.default"
            ],
            "actions": [
              "ohos.want.action.viewData",
              "ohos.want.action.sendData",
              "ohos.want.action.sendMultipleData"
            ],
            "uris": [
              {
                "scheme": "file",
                "type": "application/pdf"
              }
            ]
          },
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "https",
                "host": "notability.com",
                "pathStartWith": "app/note"
              },
              {
                "scheme": "http",
                "host": "notability.com",
                "pathStartWith": "app/note"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "NoteFormAbility",
        "srcEntry": "./ets/noteformability/NoteFormAbility.ets",
        "label": "$string:form_ability_label",
        "description": "$string:form_new_note_desc",
        "type": "form",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:forms_config"
          }
        ]
      },
      {
        "name": "FolderFormEditAbility",
        "srcEntry": "./ets/noteformeditability/FolderFormEditAbility.ets",
        "type": "formEdit",
        "exported": false
      },
      {
        "name": "NoteThumbnailFormEditAbility",
        "srcEntry": "./ets/noteformeditability/NoteThumbnailFormEditAbility.ets",
        "type": "formEdit",
        "exported": false
      },
      {
        "name": "NoteBackupAbility",
        "srcEntry": "./ets/notebackupability/NoteBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ]
  }
}
